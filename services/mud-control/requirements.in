# mud-control runtime dependencies (Phase 0 lock)
# Target: Python 3.12
#
# mcp is pinned to the exact version Hermes Agent v2026.8.18 pins
# (pyproject.toml: mcp = ["mcp==2.0.0", ...]), so the MCP client and
# server sides of the boundary agree on protocol and types.
mcp==2.0.0

# starlette floor raised above the mcp 2.0.0 declared floor (>=0.27).
# CVE-2026-48710 (GHSA-86qp-5c8j-p5mr) is a Host-header validation flaw that
# poisons request.url.path and bypasses path-based checks. The mcp floor would
# otherwise permit a vulnerable starlette on a future rebuild.
starlette>=1.3.1
